{
  "name": "tradebooks",
  "version": "1.0.0",
  "private": true,
  "description": "TradeBooks — AI-assisted bookkeeping and back-office software for UK trades",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "15.5.23",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "22.10.5",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "dotenv": "^16.4.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "postcss": "8.5.26",
    "tailwindcss": "4.1.13",
    "tsx": "4.23.12",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
}
