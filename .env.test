# Test-only configuration. These are placeholder values, not secrets.
# `npm run test` runs against this database and will TRUNCATE its tables.
NODE_ENV=test
DATABASE_URL=postgres://tradebooks:tradebooks@127.0.0.1:5432/tradebooks_test
AUTH_SECRET=test-only-placeholder-secret-not-used-in-production-0123
APP_BASE_URL=http://localhost:3000
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage/test
SEED_DEMO_PASSWORD=DemoPassw0rd!
# Signing in repeatedly is exactly what the limiter blocks, so it is off here.
DISABLE_RATE_LIMIT=true
