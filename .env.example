# ---------------------------------------------------------------------------
# TradeBooks environment configuration
# Copy to `.env` and fill in. Only DATABASE_URL and AUTH_SECRET are required.
# Everything else is optional; TradeBooks runs fully standalone without them.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
DATABASE_URL="postgres://postgres:postgres@localhost:5432/tradebooks"
AUTH_SECRET="change-me-to-a-long-random-value-at-least-32-chars"

# --- Recommended ----------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Optional: file/receipt storage --------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Optional: receipt OCR / document extraction --------------------------
OCR_DRIVER="builtin"
# OCR_HTTP_ENDPOINT=""
# OCR_HTTP_API_KEY=""

# --- Optional: AI suggestion provider -------------------------------------
AI_DRIVER="none"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"

# --- Optional: email / notification delivery ------------------------------
EMAIL_DRIVER="log"
# EMAIL_FROM="TradeBooks <no-reply@example.com>"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# --- Optional: bank feed / Open Banking -----------------------------------
# GoCardless Bank Account Data is the preferred provider for the current pilot.
# Keep the TrueLayer values below as a switch-back option.
#
# To use GoCardless:
# OPEN_BANKING_PROVIDER="gocardless"
# GOCARDLESS_SECRET_ID=""
# GOCARDLESS_SECRET_KEY=""
# GOCARDLESS_REDIRECT_URI="https://your-domain.example/api/bank/callback"
# For sandbox testing, omit GOCARDLESS_INSTITUTION_ID and TradeBooks uses
# GoCardless Sandbox Finance automatically. For a real bank, set the bank's
# institution ID returned by the GoCardless institutions endpoint.
# GOCARDLESS_INSTITUTION_ID=""
#
# To switch back to TrueLayer, remove OPEN_BANKING_PROVIDER (or set it to
# "truelayer") and retain the existing TrueLayer configuration below.
BANK_FEED_DRIVER="none"
TRUELAYER_ENV="sandbox"
# TRUELAYER_CLIENT_ID=""
# TRUELAYER_CLIENT_SECRET=""
# TRUELAYER_REDIRECT_URI="https://your-domain.example/api/bank/callback"

# --- Optional: accounting package connectors ------------------------------
# XERO_CLIENT_ID=""
# XERO_CLIENT_SECRET=""
# XERO_REDIRECT_URI=""
# QUICKBOOKS_CLIENT_ID=""
# QUICKBOOKS_CLIENT_SECRET=""
# QUICKBOOKS_REDIRECT_URI=""
# FREEAGENT_CLIENT_ID=""
# FREEAGENT_CLIENT_SECRET=""
# FREEAGENT_REDIRECT_URI=""

# --- Optional: HMRC submission boundary -----------------------------------
# HMRC_CLIENT_ID=""
# HMRC_CLIENT_SECRET=""

# --- Demo seed ------------------------------------------------------------
SEED_DEMO_PASSWORD="DemoPassw0rd!"
