# ---------------------------------------------------------------------------
# TradeBooks environment configuration
# Copy to `.env` and fill in. Only DATABASE_URL and AUTH_SECRET are required.
# Everything else is optional; TradeBooks runs fully standalone without them.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgres://postgres:postgres@localhost:5432/tradebooks"

# Secret used to sign/derive session material. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters.
AUTH_SECRET="change-me-to-a-long-random-value-at-least-32-chars"

# --- Recommended ----------------------------------------------------------
# Public base URL of the deployment (used in emails and absolute links).
APP_BASE_URL="http://localhost:3000"

# Node environment: development | test | production
NODE_ENV="development"

# --- Optional: file/receipt storage --------------------------------------
# STORAGE_DRIVER: local | s3   (default: local)
STORAGE_DRIVER="local"
# Directory used by the local storage driver (relative paths resolve from cwd).
STORAGE_LOCAL_DIR="./storage"
# S3-compatible storage (only when STORAGE_DRIVER=s3)
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# --- Optional: receipt OCR / document extraction --------------------------
# OCR_DRIVER: builtin | none | http   (default: builtin heuristic extractor)
OCR_DRIVER="builtin"
# OCR_HTTP_ENDPOINT=""
# OCR_HTTP_API_KEY=""

# --- Optional: AI suggestion provider -------------------------------------
# AI_DRIVER: none | anthropic   (default: none — deterministic rules only)
AI_DRIVER="none"
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-sonnet-5"

# --- Optional: email / notification delivery ------------------------------
# EMAIL_DRIVER: log | smtp   (default: log — messages recorded in the outbox)
EMAIL_DRIVER="log"
# EMAIL_FROM="TradeBooks <no-reply@example.com>"
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""

# --- Optional: bank feed / open banking -----------------------------------
# BANK_FEED_DRIVER: none | truelayer   (default: none — CSV import + manual entry)
BANK_FEED_DRIVER="none"
# TRUELAYER_CLIENT_ID=""
# TRUELAYER_CLIENT_SECRET=""
# TRUELAYER_REDIRECT_URI=""

# --- Optional: accounting package connectors ------------------------------
# All optional. TradeBooks is the canonical record; these are export/sync only.
# XERO_CLIENT_ID=""
# XERO_CLIENT_SECRET=""
# XERO_REDIRECT_URI=""
# QUICKBOOKS_CLIENT_ID=""
# QUICKBOOKS_CLIENT_SECRET=""
# QUICKBOOKS_REDIRECT_URI=""
# FREEAGENT_CLIENT_ID=""
# FREEAGENT_CLIENT_SECRET=""
# FREEAGENT_REDIRECT_URI=""

# --- Optional: HMRC submission boundary -----------------------------------
# Not implemented in V1. TradeBooks prepares data; it does not file returns.
# HMRC_CLIENT_ID=""
# HMRC_CLIENT_SECRET=""

# --- Demo seed ------------------------------------------------------------
# Password given to the seeded demo accounts (development/demo use only).
SEED_DEMO_PASSWORD="DemoPassw0rd!"
